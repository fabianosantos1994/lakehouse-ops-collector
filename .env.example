# Copie para .env e ajuste. O .env não é versionado e é lido pela API ao subir.

# API REST do Airflow do lakehouse-infra.
AIRFLOW_API_URL=http://127.0.0.1:8080
# Fase 1: admin local (AIRFLOW_ADMIN_USERNAME e AIRFLOW_ADMIN_PASSWORD do
# docker/.env do lakehouse-infra). Trocar por um usuário Viewer: MP-26.
AIRFLOW_USERNAME=admin
AIRFLOW_PASSWORD=admin
AIRFLOW_TIMEOUT_SECONDS=10

# Endereço da API de detecção (só loopback).
DETECTION_API_HOST=127.0.0.1
DETECTION_API_PORT=8090

# Registro de incidentes: banco ops do postgres-ops (stack ops do lakehouse-infra).
# Valores do OPS_DB_* do docker/.env de lá; a senha não tem padrão no código.
OPS_DB_HOST=127.0.0.1
OPS_DB_PORT=5435
OPS_DB_NAME=ops
OPS_DB_USER=ops
OPS_DB_PASSWORD=ops

# Poller: pausa entre uma rodada e a seguinte.
POLLER_INTERVAL_SECONDS=30
